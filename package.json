{
  "name": "harmony_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "export NODE_ENV=dev NODE_OPTIONS='--max-old-space-size=4096' && nest start",
    "start:dev": "export NODE_ENV=dev && nest start --watch",
    "start:prod": "export NODE_ENV=production && pnpm migration:run && nest start",
    "start:test": "export NODE_ENV=test && nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "test:e2e": "jest --config ./enf/test/jest-e2e.json",
    "----------------------------------CORE---------------------------": "echo \"Core Scripts\" && exit 0",
    "migration:generate": "pnpm typeorm migration:generate ./src/migration/migrations/migrations -d ./src/migration/migration.config.ts -p",
    "migration:run": "pnpm typeorm migration:run -d ./src/migration/migration.config.ts",
    "migration:revert": "typeorm migration:revert -d ./src/migration/migration.config.ts"
  },
  "dependencies": {
    "@bugsnag/js": "^8.1.2",
    "@bugsnag/plugin-express": "^8.1.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.4.16",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/multer": "^1.4.12",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^5.5.1",
    "ccxt": "^4.5.73",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "dotenv": "17.2.1",
    "express": "^5.1.0",
    "flutterwave-node-v3": "^1.3.1",
    "ioredis": "^5.6.1",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.10.58",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "2.0.0",
    "nestjs-pino": "^4.0.0",
    "node-binance-api": "^1.0.33",
    "node-geocoder": "^4.3.0",
    "nodemailer": "^7.0.5",
    "onesignal-node": "^3.4.0",
    "pg": "^8.11.3",
    "pino-http": "^10.4.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^13.4.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.7.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.4",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.5.0",
    "pg-mem": "^3.0.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "testcontainers": "^11.0.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
